{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "evergreen-consultation",
  "account_id": "4fe85a31fa782a90b1758694d2314e0a",
  "main": "worker.mjs",
  "compatibility_date": "2026-04-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://tycheventuresllc.com,https://canyon-and-vine-electrology.sukhpalc.chatgpt.site,https://evergreenelectrolysisstudio.com"
  },
  // The private service renders and sends only the fixed Nav inquiry template.
  "services": [{ "binding": "INQUIRY_MAIL", "service": "evergreen-intake-stage-mail" }]
  // Set TURNSTILE_SECRET_KEY with `wrangler secret put`; never put it in this file.
}
