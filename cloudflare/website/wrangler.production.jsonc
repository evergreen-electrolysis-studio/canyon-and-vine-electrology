{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Custom domains are managed in the Cloudflare dashboard.
  // Keep route/routes absent and workers_dev false to preserve that binding.
  "name": "evergreen-website",
  "account_id": "4fe85a31fa782a90b1758694d2314e0a",
  "compatibility_date": "2026-04-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../out/evergreen-production",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
